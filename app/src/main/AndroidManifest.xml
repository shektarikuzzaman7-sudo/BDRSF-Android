<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ইন্টারনেট ও নেটওয়ার্ক পারমিশন -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- ক্যামেরা পারমিশন (কিউআর স্ক্যান, প্রোফাইল ছবি ও কেওয়াইসি ডকুমেন্ট আপলোড) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ফাইল ম্যানেজার, গ্যালারি ও ডকুমেন্ট (পিডিএফ, ছবি, ডাউনলোড ও শেয়ার) এক্সেস পারমিশন -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    
    <!-- Android 13+ (API 33+) এর জন্য লেটেস্ট মিডিয়া পারমিশন -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- লোকেশন পারমিশন (প্রয়োজনীয় কেওয়াইসি বা লোকেশন ভেরিফিকেশনের জন্য) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BDRSF"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|keyboardHidden|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ক্যামেরা থেকে ফাইল নিরাপده শেয়ার করার জন্য FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
