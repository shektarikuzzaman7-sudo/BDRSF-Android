<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BDRSF-Android অ্যাপের প্রধান থিম (Edge-to-Edge Transparent System Bars) -->
    <style name="Theme.BDRSFAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- প্রাথমিক ব্র্যান্ডিং কালার -->
        <item name="colorPrimary">#00A86B</item>
        <item name="colorPrimaryVariant">#007A4D</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- সেকেন্ডারি অ্যাকসেন্ট কালার (গোল্ডেন) -->
        <item name="colorSecondary">#FFD700</item>
        <item name="colorSecondaryVariant">#FFA000</item>
        <item name="colorOnSecondary">#002B1D</item>

        <!-- স্বচ্ছ কাচের মতো সিস্টেম বার (নিচ দিয়ে ওয়েবসাইটের থিম কালার দেখা যাবে) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- উইন্ডো ব্যাকগ্রাউন্ড -->
        <item name="android:windowBackground">#04130F</item>

        <!-- লাইট স্ট্যাটাস ও নেভিগেশন বার বন্ধ রাখা (সাদা আইকন নিশ্চিত করতে) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
