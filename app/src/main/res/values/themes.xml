<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BDRSF-Android অ্যাপের প্রধান থিম -->
    <style name="Theme.BDRSFAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- প্রাথমিক ব্র্যান্ডিং কালার -->
        <item name="colorPrimary">#00A86B</item>
        <item name="colorPrimaryVariant">#007A4D</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- সেকেন্ডারি অ্যাকসেন্ট কালার (গোল্ডেন) -->
        <item name="colorSecondary">#FFD700</item>
        <item name="colorSecondaryVariant">#FFA000</item>
        <item name="colorOnSecondary">#002B1D</item>

        <!-- সিস্টেম বার কালার -->
        <item name="android:statusBarColor">#0A2F1D</item>
        <item name="android:navigationBarColor">#000000</item>

        <!-- উইন্ডো ব্যাকগ্রাউন্ড -->
        <item name="android:windowBackground">#0A2F1D</item>

        <!-- লাইট স্ট্যাটাস বার বন্ধ রাখা (সাদা আইকন নিশ্চিত করতে) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
